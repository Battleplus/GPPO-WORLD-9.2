Subject: [PATCH] fix causal payload propagation and low confidence
 confirmation

---
 event_runtime/detector.py                     | 17 +++++++----
 event_runtime/state_machine.py                | 10 +++++--
 ppo_allocation/random_event/environment.py    |  1 +
 ppo_allocation/random_event/runtime_bridge.py |  5 +++-
 .../test_confirmation_timelines.py            | 30 ++++++++++++++++++-
 .../test_event_runtime_integration.py         | 30 ++++++++++++++++++-
 6 files changed, 81 insertions(+), 12 deletions(-)

diff --git a/event_runtime/detector.py b/event_runtime/detector.py
index a23af07..4ca565f 100644
--- a/event_runtime/detector.py
+++ b/event_runtime/detector.py
@@ -36,26 +36,31 @@ class EventDetector:
 
     @staticmethod
     def _signal_plan(event: TruthEvent, profile: WeakCommunicationProfile) -> list[tuple[str, str, float, float]]:
+        payload_confidence = event.payload.get("confidence")
+
+        def confidence(default: float) -> float:
+            return float(payload_confidence) if payload_confidence is not None else default
+
         if event.event_type is EventType.UAV_DAMAGE:
             if bool(event.payload.get("active_report", False)):
-                return [("ACTIVE_FAILURE_REPORT", "onboard_self_test", 0.05, 0.99)]
+                return [("ACTIVE_FAILURE_REPORT", "onboard_self_test", 0.05, confidence(0.99))]
             return [
-                ("HEARTBEAT_MISSED", "heartbeat_monitor", profile.heartbeat_interval * index, 0.75)
+                ("HEARTBEAT_MISSED", "heartbeat_monitor", profile.heartbeat_interval * index, confidence(0.75))
                 for index in range(1, profile.heartbeat_miss_threshold + 1)
             ]
         if event.event_type is EventType.TARGET_DISCOVERED:
             return [
-                ("TARGET_DETECTION", "eo_ir", 0.10 * index, min(0.99, 0.68 + index * 0.08))
+                ("TARGET_DETECTION", "eo_ir", 0.10 * index, confidence(min(0.99, 0.68 + index * 0.08)))
                 for index in range(1, profile.target_confirmation_count + 1)
             ]
         if event.event_type is EventType.TARGET_DESTROYED:
             if bool(event.payload.get("authoritative", False)):
-                return [("AUTHORITATIVE_TARGET_DESTROYED", "command_system", 0.05, 0.99)]
+                return [("AUTHORITATIVE_TARGET_DESTROYED", "command_system", 0.05, confidence(0.99))]
             return [
-                ("TARGET_DESTROYED_EVIDENCE", "eo_sar", 0.15 * index, 0.90)
+                ("TARGET_DESTROYED_EVIDENCE", "eo_sar", 0.15 * index, confidence(0.90))
                 for index in range(1, profile.destruction_confirmation_count + 1)
             ]
-        return [("REGION_LEASE_VACANT", "lease_monitor", 0.05, 0.99)]
+        return [("REGION_LEASE_VACANT", "lease_monitor", 0.05, confidence(0.99))]
 
     def generate_observation_tape(self, truth_tape: TruthEventTape) -> ObservationTape:
         rng = self._rng(truth_tape.initial_seed, truth_tape.event_seed, self.profile.name)
diff --git a/event_runtime/state_machine.py b/event_runtime/state_machine.py
index 34899b7..bf767c4 100644
--- a/event_runtime/state_machine.py
+++ b/event_runtime/state_machine.py
@@ -119,11 +119,15 @@ class ConfirmationStateMachine:
         return cleared
 
     def _required_evidence(self, observation: Observation) -> int:
+        # A low-confidence observation cannot satisfy a one-sensor direct
+        # confirmation path.  It needs two independent positive sources; the
+        # event-specific rules below may require even more.
+        low_confidence_required = 2 if observation.confidence < 0.95 else 1
         if observation.event_type is EventType.TARGET_DISCOVERED:
-            return self.target_confirmation_count
+            return max(self.target_confirmation_count, low_confidence_required)
         if observation.event_type is EventType.TARGET_DESTROYED:
-            return self.destruction_confirmation_count
-        return 1
+            return max(self.destruction_confirmation_count, low_confidence_required)
+        return low_confidence_required
 
     @staticmethod
     def _direct_confirmation(observation: Observation) -> bool:
