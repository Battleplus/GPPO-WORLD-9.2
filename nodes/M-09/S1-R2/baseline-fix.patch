diff --git a/ppo_allocation/random_event/runtime_bridge.py b/ppo_allocation/random_event/runtime_bridge.py
index 3a15104..ee698ca 100644
--- a/ppo_allocation/random_event/runtime_bridge.py
+++ b/ppo_allocation/random_event/runtime_bridge.py
@@ -218,6 +218,8 @@ class DeterministicDetector:
         emitted_at = truth_event.occurred_at + observation_delay
         received_at = emitted_at + order_jitter
 
+        payload_confidence = truth_event.payload.get("confidence")
+        confidence = float(payload_confidence) if payload_confidence is not None else (0.95 if not is_false_positive else 0.3)
         obs = Observation(
             observation_id=f"OBS-{truth_event.event_id}-{int(self.rng.integers(0, 10**9))}",
             event_id=truth_event.event_id,
@@ -227,7 +229,7 @@ class DeterministicDetector:
             source_type="sensor",
             signal_type=signal_type_override or self._signal_type_for(truth_event),
             sequence=1,
-            confidence=0.95 if not is_false_positive else 0.3,
+            confidence=confidence,
             positive=True if not is_false_positive else bool(self.rng.integers(0, 2)),
             emitted_at=emitted_at,
             received_at=received_at,
@@ -238,6 +240,7 @@ class DeterministicDetector:
             severity=truth_event.severity,
             event_seed=truth_event.event_seed,
             state_version=truth_event.state_version,
+            payload=dict(truth_event.payload),
             is_false_positive=is_false_positive,
         )
         return obs
diff --git a/ppo_allocation/tests_random_event/test_confirmation_timelines.py b/ppo_allocation/tests_random_event/test_confirmation_timelines.py
index 12394f1..0c30113 100644
--- a/ppo_allocation/tests_random_event/test_confirmation_timelines.py
+++ b/ppo_allocation/tests_random_event/test_confirmation_timelines.py
@@ -139,7 +139,35 @@ class TruthBeliefIsolationTests(unittest.TestCase):
         self.assertEqual(env.graph_version, gv_before)
         self.assertEqual(env.decision_version, dv_before)
         graph_after = build_graph_state(env)
-        self.assertTrue(torch.equal(mask_before, graph_after.action_mask))
+        self.assertTrue(np.array_equal(mask_before.numpy(), graph_after.action_mask.numpy()))
+
+
+class LowConfidenceConfirmationTests(unittest.TestCase):
+    def test_low_confidence_region_requires_two_independent_sources(self):
+        adapter = EventRuntimeAdapter()
+        first = _obs(
+            event_id="LOW-REGION",
+            event_type=EventType.REGION_VACANCY,
+            signal_type="REGION_LEASE_VACANT",
+            source_id="src-0",
+            confidence=0.55,
+            affected_targets=(),
+            affected_regions=("0",),
+        )
+        second = _obs(
+            event_id="LOW-REGION",
+            event_type=EventType.REGION_VACANCY,
+            signal_type="REGION_LEASE_VACANT",
+            source_id="src-1",
+            confidence=0.55,
+            affected_targets=(),
+            affected_regions=("0",),
+            sequence=2,
+        )
+        self.assertIsNone(adapter.process_observation(first))
+        self.assertEqual(adapter.state_machine.records["LOW-REGION"].status, ConfirmationStatus.SUSPECTED)
+        self.assertIsNotNone(adapter.process_observation(second))
+        self.assertEqual(adapter.state_machine.records["LOW-REGION"].status, ConfirmationStatus.CONFIRMED)
 
 
 class DiscoveryThreeOfFiveTests(unittest.TestCase):
